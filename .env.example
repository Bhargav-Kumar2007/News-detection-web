# Relative paths below are resolved from their respective cloned model repositories.
TEXT_REPO=models/NEWS-detection-using-text
IMAGE_REPO=models/NEWS-detection-using-image
TEXT_RUN_DIR=outputs/bilstm_50k_20ep

# This is the expected Fakeddit image-model path. If your checkpoint is elsewhere,
# set IMAGE_CHECKPOINT to that file (absolute path is also accepted).
IMAGE_CHECKPOINT=outputs/subset_resnet18/checkpoints/best.pt

# IMPORTANT: the text repository leaves the label_0 / label_1 semantics unresolved.
# Set these only after verifying the text checkpoint's class-id mapping.
# Expected values: FAKE and REAL. Leave blank to disable the combined score safely.
TEXT_LABEL_0=
TEXT_LABEL_1=

# auto | cpu | cuda | mps
MODEL_DEVICE=auto
MAX_UPLOAD_MB=12
